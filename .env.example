# 灵枢（SpiritScout）Docker 部署凭据模板
#   1) cp .env.example .env
#   2) 填入一个强密码（Basic Auth 用户名固定为 spiritscout）
#   3) docker compose up -d --build
#
# 注意：.env 已被 .gitignore 忽略，不要提交到仓库。
SPIRITSCOUT_SERVER_PASSWORD=please-change-me

# 可选：构建期覆盖依赖源（默认官方 PyPI）
#PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 可选：1 = 安装 CTF 工具箱（pwntools/pycryptodome/z3/scapy/binwalk/sqlmap 等）
#INSTALL_TOOLKIT=0
