# 灵枢（SpiritScout）管理员凭据模板
#   1) cp .env.example .env
#   2) 设置管理员用户名与强密码
#   3) docker compose up -d --build（本地则 ./launch.sh）
#
# 凭据在启动时导入工作区 admin.db（密码只保存 scrypt 加盐哈希）。
# 忘记用户名/密码时：修改这里的两个变量并重启服务即可覆盖恢复；
# 恢复后移除它们，数据库中的凭据继续有效。
# .env 已被 .gitignore 忽略，不要提交到仓库。
SPIRITSCOUT_ADMIN_USERNAME=spiritscout
SPIRITSCOUT_ADMIN_PASSWORD=please-change-me

# 旧版变量（仍兼容，用户名默认 spiritscout，优先级低于上面的 ADMIN_*）
#SPIRITSCOUT_SERVER_PASSWORD=please-change-me

# 可选：设为 0 关闭启动时的环境变量导入，完全由数据库维护管理员
#SPIRITSCOUT_ADMIN_SYNC=0

# 可选：构建期覆盖依赖源（默认官方 PyPI）
#PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 可选：1 = 安装 CTF 工具箱（pwntools/pycryptodome/z3/scapy/binwalk/sqlmap 等）
#INSTALL_TOOLKIT=0
